# Copy to terraform.tfvars (git-ignored) and adjust. Everything not listed keeps its default (see variables.tf).
project_id  = "codecell-vesit"
region      = "asia-south1"
alert_email = "you@example.com"

# OPTIONAL budget alert. Needs Billing Account Administrator or Billing Budgets creator on the billing account
# (gcloud billing accounts list). Leave empty to skip it and create the budget in the console instead.
billing_account_id = ""
budget_amount_usd  = 10

# Safe defaults for the first apply: schedulers paused, sweep alert off. (DRY_RUN and the other runtime settings live in
# deploy/backend.env.yaml, not here.)
scheduler_paused    = true
sweep_alert_enabled = false

github_repo    = "Harshavardhan-28/Mail-autosender-service"
github_repository_id = "123456789" # gh api repos/Harshavardhan-28/Mail-autosender-service --jq .id
admin_username = "admin"
# from_name    = "Your Name"
